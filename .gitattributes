# index.html is generated by ./build.sh from src/parts/*.
# Marking it generated keeps GitHub from counting a 230 KB concatenation in the
# language stats (which would report the repo as ~100% HTML and bury the real
# source) and collapses it by default in diffs and pull requests.
index.html linguist-generated=true

# The parts are fragments, not standalone documents: p1/p6 are the HTML shell
# halves, p2-p5 are the script body. Classify them so the language bar and
# syntax highlighting reflect what they actually contain.
src/parts/p1_head.html linguist-language=HTML
src/parts/p6_tail.html linguist-language=HTML
src/parts/*.js         linguist-language=JavaScript

# Keep line endings stable across machines for the concatenated build.
*.html text eol=lf
*.js   text eol=lf
*.sh   text eol=lf
*.md   text eol=lf
